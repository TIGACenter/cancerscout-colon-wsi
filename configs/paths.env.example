# Optional: copy to configs/paths.env and edit to override the default locations
# (the defaults are the data/, models/ and work/ folders of this repository).
# CSWSI_WORK=/scratch/cswsi                # patches, features, splits, predictions, tables, figures
# CSWSI_MODELS=/models/cswsi                # trained models: clam/<experiment>/ and stainnet/ (models/README.md)
# CSWSI_SLIDES_CS=/data/cancerscout/slides  # discovery-cohort H&E WSIs (*.tiff), BioImage Archive release
# CSWSI_LABELS=/data/cancerscout/labels     # <dataset>/{train,eval}.csv and annotations/, released with the data
# CSWSI_STAIN_REFERENCE=/data/cancerscout/stain_reference   # the three StainNet target tiles
# CSWSI_SLIDES_CPTAC=/data/CPTAC-COAD       # CPTAC-COAD tissue slide images (*.svs), TCIA doi:10.7937/TCIA.YZWQ-ZZ63
# Encoder weights (gated on Hugging Face, see README):
CONCH_CKPT_PATH=/path/to/CONCH/pytorch_model.bin
UNI_CKPT_PATH=/path/to/UNI/pytorch_model.bin
